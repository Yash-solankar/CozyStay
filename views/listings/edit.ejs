<% layout("/layouts/boilerplate")-%>
<a href="/listings/<%=listing._id%>" class="edit-back-btn">
            <i class="fa-solid fa-arrow-left"></i> Back to listings
        </a>
<div class="row mt-3">
    <div class="col-8 offset-2">
        <div class="border border-secondary border-2 rounded-3 mx-5 my-4 p-5 bg-light">
    <h3>Edit your Listing</h3>
    <form method="post" action="/listings/<%=listing._id%>?_method=PUT" class="needs-validation" novalidate enctype="multipart/form-data">
        <div class="mb-3">
            <label for="title" class="form-lable">Title</label>
            <input type="text" name="listing[title]" value="<%= listing.title%>" class="form-control" required>
            <div class="invalid-feedback">Please enter title</div>
        </div>
        <div class="mb-3">
            <label for="description" class="form-lable">Description</label>
            <textarea type="text" name="listing[description]" class="form-control" required><%= listing.description%></textarea>
            <div class="invalid-feedback">Please enter a short description</div>
        </div>
        <div class="mb-3">
            Original Listing Image <br>
            <img src="<%=listing.image.url%>" style="width: 150px; height: 120px;">
        </div>
        <div class="mb-3">
            <label for="image" class="form-lable">Upload New Image</label>
            <input type="file" name="listing[image]" class="form-control">
        </div>
        <div class="row">
            <div class="mb-3 col-md-4">
                <label for="price" class="form-lable">Price</label>
                <input type="number" name="listing[price]" value="<%= listing.price%>" class="form-control" required>
                <div class="invalid-feedback">Please enter a valid price</div>
            </div>
            <div class="mb-3 col-md-8">
                <label for="country" class="form-lable">Country</label>
                <input type="text" name="listing[country]" value="<%= listing.country%>" class="form-control" required>
                <div class="invalid-feedback">Country name should be valid</div>
            </div>
        </div>
        <div class="mb-3">
            <label for="location" class="form-lable">Location</label>
            <input type="text" name="listing[location]" value="<%= listing.location%>" class="form-control" required>
            <div class="invalid-feedback">Location name should be valid</div>
        </div>
        <div class="mb-3">
            <button class="btn btn-dark edit-btn mt-3">Edit</button>
        </div>
    </form>
    </div>
    </div>
</div>