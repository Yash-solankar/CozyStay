<%if(success && success.length){%>
    <div class="alert alert-success alert-dismissible fade show col-4 offset-3 mt-2 flash-message" role="alert">
        <%=success%>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>


<%if(error && error.length){%>
    <div class="alert alert-danger alert-dismissible fade show col-4 offset-3 mt-2 flash-message" role="alert">
        <%=error%>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<%}%>

<script>
    setTimeout(()=>{
        document.querySelectorAll(".flash-message").forEach(alert=>{
            bootstrap.Alert.getOrCreateInstance(alert).close();
        });
    }, 3000);
</script>
